# SBTI 生产环境变量
# ====================

# MongoDB（腾讯云MongoDB复用）
MONGODB_URI=mongodb://your-mongo-host:27017
DB_NAME=sbti

# 腾讯云配置（云函数SCF）
TENCENT_SECRET_ID=your-secret-id
TENCENT_SECRET_KEY=your-secret-key
TENCENT_APPID=your-appid

# 微信小程序（登录+支付）
WECHAT_MINI_APPID=wxbd555f94c0301a61
WECHAT_MCHID=your-mchid
WECHAT_APIKEY=your-apikey
WECHAT_APP_SECRET=your-app-secret

# 其他
NODE_ENV=production
